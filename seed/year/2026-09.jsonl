{"key": "2026-09-01-0098", "ts": "2026-09-01T18:40:36+01:00", "author": "teo", "type": "message", "payload": {"text": "Eating standing up. I have made an omelette that is technically a scramble."}}
{"key": "2026-09-01-0099", "ts": "2026-09-01T18:44:03+01:00", "author": "noor", "type": "message", "payload": {"text": "photograph it"}}
