{"key": "2026-09-01-0087", "ts": "2026-09-01T17:28:47+01:00", "author": "teo", "type": "message", "payload": {"text": "It cannot move. It has a day in its name."}}
{"key": "2026-09-01-0088", "ts": "2026-09-01T17:31:13+01:00", "author": "noor", "type": "message", "payload": {"text": "it moves to wednesday and then it gets judged on wednesday terms"}}
{"key": "2026-09-01-0089", "ts": "2026-09-01T17:34:39+01:00", "author": "teo", "type": "message", "payload": {"text": "What are wednesday terms."}}
