{"key": "2026-09-01-0074", "ts": "2026-09-01T16:12:04+01:00", "author": "noor", "type": "feeling", "payload": {"feeling_id": "tangled", "intensity": 0.45}}
{"key": "2026-09-01-0075", "ts": "2026-09-01T16:20:31+01:00", "author": "noor", "type": "message", "payload": {"text": "im not going to make a thing of it. its four nights, its the job, and i knew about the job before i knew about you"}}
{"key": "2026-09-01-0076", "ts": "2026-09-01T16:23:57+01:00", "author": "teo", "type": "message", "payload": {"text": "Make a small thing of it. A small thing is allowed and I would rather have it now than in october."}}
