{"key": "2026-09-01-0080", "ts": "2026-09-01T16:52:42+01:00", "author": "noor", "type": "message", "payload": {"text": "bus. a boy on the back seat with a full sized house plant on his lap and no explanation offered to anybody"}}
{"key": "2026-09-01-0081", "ts": "2026-09-01T16:55:09+01:00", "author": "teo", "type": "message", "payload": {"text": "That is the best thing I have been told today and I have only been awake for two hours."}}
{"key": "2026-09-01-0082", "ts": "2026-09-01T17:10:35+01:00", "author": "noor", "type": "state_declared", "payload": {"signal": "place", "value": "home"}}
