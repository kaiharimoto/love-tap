{"key": "2026-09-01-0083", "ts": "2026-09-01T17:14:01+01:00", "author": "noor", "type": "message", "payload": {"text": "in. the flat smells of nothing at all, which is the best it ever smells"}}
{"key": "2026-09-01-0084", "ts": "2026-09-01T17:18:28+01:00", "author": "noor", "type": "message", "payload": {"text": "there is no soup today is there"}}
{"key": "2026-09-01-0085", "ts": "2026-09-01T17:22:54+01:00", "author": "teo", "type": "message", "payload": {"text": "There is no soup today. I have been upright since three and the shops are a bridge too far."}}
{"key": "2026-09-01-0086", "ts": "2026-09-01T17:25:20+01:00", "author": "noor", "type": "message", "payload": {"text": "then it moves to wednesday"}}
{"key": "2026-09-01-9514", "ts": "2026-09-01T17:25:36+01:00", "author": "noor", "type": "state_passive", "payload": {"signal": "at_home", "value": true}, "gen": "finish"}
