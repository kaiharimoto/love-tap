# pinned toolchain installed by bootstrap.sh (never committed)
/toolchain/
# build output
/app/build/
/app/.dart_tool/
/app/.flutter-plugins*
/app/android/.gradle/
/app/android/local.properties
/app/android/app/.cxx/
/app/.idea/
*.iml
# secrets: never committed
.env
*.authkey
/toolchain/ts/
# scratch
/tmp/
/.scratch/
__pycache__/
*.pyc
node_modules/
# generated by tools/pack_assets.py from assets/ at build time; never edited by hand and never
# committed, so the repo holds the renders rather than the display-resolution copies of them
/app/assets/
# derived from evidence/*.png so the next session can measure a diff; not an artifact
/evidence/.previous/
/evidence/frames/
# clip frames: the intermediate the mp4 is assembled from, never the artifact
/evidence/frames/
/evidence/.previous/
/evidence/.diffscratch/

# the negatives: what still.py exposes, before blender/photos/develop.py applies the sensor to it.
# One is eleven megabytes and develop.py deletes it as soon as it has been developed, so a
# negative in the tree is a render in flight rather than something anyone needs.
/seed/photos/*.exr
/blender/videos/scratch/
# working room for the render queue: frames of a take, on their way to an mp4
/scratch/
